# Conexão com o Postgres (Neon ou Supabase). Sem ela, o servidor local usa PGlite em ./data/pg
DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require
# Credenciais do administrador criado na primeira execução (banco vazio)
ADMIN_LOGIN=admin
ADMIN_PASSWORD=troque-esta-senha
# Token para a API de integração dos rastreadores (/api/integracao)
INTEGRATION_TOKEN=gere-um-token-longo-e-aleatorio
